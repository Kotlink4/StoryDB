{
    "ConnectionStrings":  {
                              "StoryDb":  "Host=localhost;Port=5432;Database=storydb;Username=postgres;Password=postgres"
                          },
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning"
                                 },
                    "FileDirectory":  "logs",
                    "RetainedFileCountLimit":  14,
                    "FileSizeLimitBytes":  20971520,
                    "SlowRequestThresholdMs":  750,
                    "AuditEnabled":  true
                },
    "Database":  {
                     "DbContextPoolSize":  128,
                     "CommandTimeoutSeconds":  30,
                     "MaxRetryCount":  3,
                     "MaxRetryDelaySeconds":  5
                 },
    "MemoryCache":  {
                        "SizeLimit":  2048
                    },
    "Media":  {
                  "MaxImagePixels":  32000000,
                  "MaxImageDimension":  12000
              },
    "Observability":  {
                          "MaxTrackedEndpoints":  200
                      },
    "Exports":  {
                    "JobQueueCapacity":  100,
                    "MaxRetainedJobs":  200,
                    "CompletedJobRetentionMinutes":  30,
                    "CleanupIntervalMinutes":  5
                },
    "ProjectSnapshots":  {
                             "RetainedCurrentRevisions":  5,
                             "RetainedPublishedRevisions":  1
                         },
    "AllowedHosts":  "*",
    "Security":  {
                     "MaxRequestBodyBytes":  2097152,
                     "MaxUploadBytes":  8388608,
                     "MaxFormValueLength":  16384,
                     "RateLimits":  {
                                        "Auth":  {
                                                     "PermitLimit":  12,
                                                     "WindowMinutes":  1
                                                 },
                                        "Upload":  {
                                                       "PermitLimit":  20,
                                                       "WindowMinutes":  1
                                                   },
                                        "Expensive":  {
                                                          "PermitLimit":  600,
                                                          "WindowMinutes":  1
                                                      }
                                    }
                 }
}
