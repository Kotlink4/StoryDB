{
    "ConnectionStrings":  {
                              "StoryDb":  "Host=localhost;Port=5432;Database=storydb;Username=postgres;Password=postgres"
                          },
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning"
                                 },
                    "FileDirectory":  "logs",
                    "RetainedFileCountLimit":  14,
                    "FileSizeLimitBytes":  20971520,
                    "SlowRequestThresholdMs":  750,
                    "AuditEnabled":  true
                },
    "AllowedHosts":  "*",
    "Security":  {
                     "RateLimits":  {
                                        "Auth":  {
                                                     "PermitLimit":  12,
                                                     "WindowMinutes":  1
                                                 },
                                        "Upload":  {
                                                       "PermitLimit":  20,
                                                       "WindowMinutes":  1
                                                   },
                                        "Expensive":  {
                                                          "PermitLimit":  600,
                                                          "WindowMinutes":  1
                                                      }
                                    }
                 }
}
